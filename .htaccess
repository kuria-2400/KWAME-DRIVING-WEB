# Apache rules for the site root.

Options -Indexes
ErrorDocument 404 /404.html

# Never serve dotfiles (.env, .git, .htaccess), SQL dumps, backups or the local test script.
<FilesMatch "^\.|\.(sql|bak|log|ini)$|^test_db\.php$">
  Require all denied
</FilesMatch>

# Code folders are not public; only /api is.
RedirectMatch 404 ^/(config|includes)(/|$)
