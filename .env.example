# Copy this file to .env and fill in real values. Never commit .env.
# On shared hosting, you can keep .env one folder ABOVE the website root and set
# ENV_PATH in your host's environment settings to point at it.

APP_ENV=production
# true only while debugging: puts error details in API responses
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kwame_school
DB_USER=kwame_app
DB_PASS=change-me

# Extra sites allowed to call the API from a browser, comma-separated.
# Leave empty when the API and the pages are on the same domain (the normal setup).
ALLOWED_ORIGINS=

# Booking notification emails (uses PHP mail()). Leave MAIL_TO empty to turn off.
MAIL_TO=kwamedrivingschool@gmail.com
MAIL_FROM=no-reply@your-domain.co.ke

# Max booking requests per visitor IP address per hour
RATE_LIMIT_PER_HOUR=5
